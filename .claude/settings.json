{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run dev:*)",
      "Bash(node --experimental-strip-types --test:*)",
      "Bash(node tools/build-reports.mjs)",
      "Bash(python3 tests/mock_server.py)",
      "Bash(python3 -m http.server:*)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./.next/**)",
      "Read(./**/*.zip)",
      "Read(./conversation-backups/**)"
    ]
  }
}
